generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  orders    Order[]
  protocol  Protocol?
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  brand          String
  description    String
  price          Float
  category       String
  certifications String[]
  // goals: which wellness goals this product supports — sleep, stress,
  // energy, immune, gut, joints, hormones, skin, mood, focus, detox,
  // kids, beauty. Same vocabulary as Recipe.goals so the two surfaces
  // share filtering logic. Default empty so newly-imported products
  // backfill cleanly when the column is added; populated by the
  // import-flow Claude extraction and editable in the admin form.
  goals          String[]
  imageUrl       String?
  affiliateUrl   String?
  supplier       String?
  asin           String?
  inStock        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  // updatedAt: Prisma's @updatedAt directive sets this to NOW() on
  // every db.product.update() call, with no code changes required at
  // each call site. The @default(now()) is here so existing rows get
  // backfilled with the current timestamp the moment the column is
  // added (otherwise the column would be NULL on rows that have never
  // been edited since the migration).
  updatedAt      DateTime    @updatedAt @default(now())
  orderItems     OrderItem[]
}

model Recipe {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  prepTime       Int
  servings       Int
  costPerServing Float
  difficulty     String
  // type: what kind of preparation this is — tea, tonic, syrup, paste,
  // smoothie, balm, tincture, oil-blend, bath-soak. Drives the type filter
  // chips on /recipes. Default "tea" so existing rows backfill cleanly when
  // the migration runs before seedRecipes is re-run.
  type           String   @default("tea")
  goals          String[]
  steps          Json
  ingredients    Json
  createdAt      DateTime @default(now())
}

model Protocol {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  goals     String[]
  items     Json
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  total     Float
  status    String      @default("pending")
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Float
}

// Subscriber rows are created every time someone opts into having a
// quiz protocol or recipe emailed to them. We deliberately allow
// duplicate (email, source) rows so each opt-in is its own audit
// record — useful for "you signed up for plan X on date Y" history.
//
// marketingOptIn is a separate consent flag from the transactional
// send: ticking it lets us include them in future broadcasts. The
// transactional email itself goes out regardless.
//
// unsubscribed propagates via email — when one row gets unsubscribed,
// the email-send API checks for any prior unsubscribed=true row for
// the same address and skips sending. unsubscribeToken is a per-row
// secret used in the link footer of every email.
model Subscriber {
  id               String   @id @default(cuid())
  email            String
  source           String   // "quiz" | "recipe" | "footer"
  referenceId      String?  // recipe slug, protocol id, etc.
  marketingOptIn   Boolean  @default(false)
  unsubscribed     Boolean  @default(false)
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([unsubscribeToken])
}